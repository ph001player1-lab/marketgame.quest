---
layout: layouts/base.njk
pagination:
  data: regions
  size: 1
  alias: region
permalink: "/{{ region.slug }}/"
pageKind: region
hasPrograms: true
eleventyComputed:
  title: "Market Game {{ region.in }} — ежемесячная деловая игра для палат и бизнес-объединений"
  ogTitle: "Для палат и бизнес-объединений {{ region.in }}"
  description: "Деловая игра-симулятор для торгово-промышленных палат и бизнес-объединений {{ region.in }}: предприниматели каждый месяц соревнуются на одном общем рынке. Платит палата или спонсор. Бесплатная демо-игра на 60 минут."
---
{# Страница региона. Одна на все 83: данные региона — из regions.json,
   статусы — из chambers.json и banks.json. #}
{% set info = regionInfo[region.abbr] %}
<section class="hero hero--state">
  <div class="wrap hero__in">
    <div class="hero__text">
      <span class="eyebrow">Market Game {{ region.in }}</span>
      <h1>Для палат <span>{{ region.in }}</span></h1>
      <p class="lede">Деловая игра для ваших участников — каждый месяц, в вашем зале. Предприниматели региона управляют конкурирующими компаниями на одном общем рынке и видят, как цена, реклама, мощности и деньги решают, кто победит. Платит палата — или спонсор.</p>

      <dl class="facts">
        <div><dt>Часовой пояс</dt><dd>{{ info.zone }}</dd></div>
        <div><dt>Палата-основатель</dt><dd>{% if info.founding.taken %}{{ info.founding.name or 'Есть' }}{% else %}<span class="badge badge--open">Свободно</span>{% endif %}</dd></div>
        <div><dt>Банковский партнёр</dt><dd>{% if info.bank.status == 'open' %}<span class="badge badge--open">Свободно</span>{% else %}{{ info.bank.name or 'Есть' }}{% endif %}</dd></div>
        <div><dt>Программ идёт</dt><dd>{{ info.active }}</dd></div>
      </dl>

      <div class="btns">
        {% if info.founding.taken %}
        <button type="button" class="btn" data-lead="chamber">Заказать демо-игру</button>
        {% else %}
        <button type="button" class="btn" data-lead="chamber" data-lead-note="Заявка на статус палаты-основателя — {{ region.name }}">Стать палатой-основателем</button>
        {% endif %}
        <button type="button" class="btn btn--line" data-lead="bank">Я представляю банк</button>
      </div>
    </div>
    {% include "partials/selector.njk" %}
  </div>
</section>

<div class="flow">
{% include "partials/stats.njk" %}
{% include "partials/chambers.njk" %}
{% include "partials/benefits.njk" %}
{% include "partials/experience.njk" %}
{% include "partials/programs.njk" %}
{% include "partials/calculator.njk" %}
{% include "partials/open-games.njk" %}
{% include "partials/scopes.njk" %}
{% include "partials/banks.njk" %}
{% include "partials/how.njk" %}
{% include "partials/faq.njk" %}
</div>
{% include "partials/cta.njk" %}
