<footer class="foot">
  <div class="wrap foot__in">
    <div>
      <a class="logo logo--sm" href="/">Бизнес <em>Квест</em></a>
      <p class="foot__line">Деловые игры для бизнес-сообществ, компаний, банков и спонсоров — в России и за рубежом.</p>
      {% if site.company.legalName %}
      <p class="foot__line">{{ site.company.legalName }}{% if site.company.inn %} · ИНН {{ site.company.inn }}{% endif %}{% if site.company.address %} · {{ site.company.address }}{% endif %}</p>
      {% endif %}
    </div>
    <nav class="foot__nav" aria-label="Меню в подвале">
      <a href="/#regions">Выбрать регион</a>
      <a href="/nationwide/">По всей России</a>
      <a href="/international/">Международные</a>
      <a href="/banks/">Банкам и спонсорам</a>
      <a href="{{ site.game.url }}">Как устроена игра</a>
      <a href="/ai/">Обучение ИИ</a>
      <a href="/agents/">Карьера · Вакансии</a>
      <a href="/requisites/">Реквизиты</a>
      <a href="/privacy/">Конфиденциальность</a>
      {% if site.contact.email %}<a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}
    </nav>
  </div>
</footer>
